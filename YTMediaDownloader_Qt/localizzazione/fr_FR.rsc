        <entry key="grp_subs" default="Sottotitoli da Allegare (Selezione Multipla)" localized="Sous-titres à Joindre (Sélection Multiple)"/>
        <entry key="btn_select_all" default="Seleziona Tutti" localized="Tout Sélectionner"/>
        <entry key="btn_deselect_all" default="Deseleziona Tutti" localized="Tout Désélectionner"/>
        <entry key="btn_confirm" default="Conferma Selezione" localized="Confirmer la Sélection"/>
        <entry key="btn_cancel" default="Annulla" localized="Annuler"/>
        <entry key="header_audio_orig" default="--- TRACCE AUDIO ORIGINALI ---" localized="--- PISTES AUDIO ORIGINALES ---"/>
        <entry key="header_audio_app" default="--- TRACCE AUDIO LOCALIZZATE (%1) ---" localized="--- PISTES AUDIO LOCALISÉES (%1) ---"/>
        <entry key="header_audio_other" default="--- ALTRE TRACCE AUDIO ---" localized="--- AUTRES PISTES AUDIO ---"/>
        <entry key="header_subs_orig" default="--- SOTTOTITOLI ORIGINALI ---" localized="--- SOUS-TITRES ORIGINAUX ---"/>
        <entry key="header_subs_app" default="--- SOTTOTITOLI LOCALIZZATI (%1) ---" localized="--- SOUS-TITRES LOCALISÉS (%1) ---"/>
        <entry key="header_subs_other" default="--- ALTRI SOTTOTITOLI ---" localized="--- AUTRES SOUS-TITRES ---"/>
    </window>
    <window name="SettingsDialog">
        <entry key="window_title" default="Preferenze Applicazione" localized="Préférences de l'Application"/>
        <entry key="grp_general" default="Impostazioni Generali" localized="Paramètres Généraux"/>
        <entry key="lbl_default_path" default="Percorso di Salvataggio Predefinito:" localized="Dossier d'Enregistrement par Défaut :"/>
        <entry key="lbl_default_lang" default="Lingua Predefinita:" localized="Langue par Défaut :"/>
        <entry key="btn_save" default="Salva Preferenze" localized="Enregistrer les Préférences"/>
        <entry key="btn_cancel" default="Annulla" localized="Annuler"/>
    </window>
    <window name="HelpDialog">
        <entry key="window_title" default="Guida Utente - YTMediaDownloader" localized="Guide Utilisateur - YTMediaDownloader"/>
        <entry key="lbl_guide_lang" default="Lingua Guida:" localized="Langue du Guide :"/>
        <entry key="btn_open_browser" default="Apri nel Browser" localized="Ouvrir dans le Navigateur"/>
        <entry key="btn_close" default="Chiudi" localized="Fermer"/>
    </window>
    <window name="AboutDialog">
        <entry key="window_title" default="Informazioni su YT Media Downloader Pro" localized="À propos de YT Media Downloader Pro"/>
        <entry key="app_name" default="YT Media Downloader Pro" localized="YT Media Downloader Pro"/>
        <entry key="idea_credit" default="Software realizzato con IA su un'idea di PsyTech6." localized="Software realizzato con IA su un'idea di PsyTech6."/>
        <entry key="app_description" default="Strumento avanzato e ad alte prestazioni per l'analisi, il download, l'estrazione e il muxing di flussi multimediali da YouTube. Supporta risoluzioni video fino a 4K/8K, download multitraccia con canali audio localizzati e integrazione dei sottotitoli conformi agli standard ISO 639." localized="Outil avancé à haute performance pour l'analyse, le téléchargement et le multiplexage de flux multimédias YouTube. Prend en charge les résolutions vidéo jusqu'à 4K/8K, le téléchargement multipiste avec audio localisé et l'intégration de sous-titres conformes à la norme ISO 639."/>
        <entry key="tech_info" default="Tecnologie integrate: Qt 5 (C++17), FFmpeg / ffprobe multithread, yt-dlp con protocollo anti-rate limit. Rilasciato come pacchetto portabile standalone universale." localized="Technologies intégrées : Qt 5 (C++17), FFmpeg / ffprobe multithread, yt-dlp avec protocole anti-limitation. Distribué sous forme de paquet autonome universel."/>
        <entry key="btn_close" default="Chiudi" localized="Fermer"/>
    </window>
</localization>
