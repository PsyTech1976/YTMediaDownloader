        <entry key="summary_resolution" default="Risoluzione Selezionata" localized="Résolution Sélectionnée"/>
        <entry key="summary_container" default="Contenitore" localized="Conteneur"/>
        <entry key="summary_audio_tracks" default="Tracce Audio Selezionate" localized="Pistes Audio Sélectionnées"/>
        <entry key="summary_subtitles" default="Sottotitoli Selezionati" localized="Sous-titres Sélectionnés"/>
        <entry key="summary_default_audio" default="Audio Predefinito" localized="Audio par Défaut"/>
        <entry key="summary_no_subtitles" default="Nessun sottotitolo" localized="Aucun sous-titre"/>
        <entry key="already_running_title" default="Applicazione già attiva" localized="Application déjà active"/>
        <entry key="already_running_msg" default="Un'altra istanza di YTMediaDownloader è già in esecuzione nel sistema. Non è consentito eseguire più istanze contemporaneamente." localized="Une autre instance de YTMediaDownloader est déjà en cours d'exécution. Les instances multiples ne sont pas autorisées."/>
    </window>
    <window name="MediaAnalyzerDialog">
        <entry key="window_title" default="Analisi e Selezione Tracce Media" localized="Analyse et Sélection des Pistes Média"/>
        <entry key="grp_video" default="Formato e Risoluzione Video" localized="Format et Résolution Vidéo"/>
        <entry key="lbl_resolution" default="Risoluzione Video:" localized="Résolution Vidéo :"/>
        <entry key="lbl_container" default="Contenitore Output:" localized="Conteneur de Sortie :"/>
