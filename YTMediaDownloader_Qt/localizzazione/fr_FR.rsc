        <entry key="act_about" default="Informazioni sul Software..." localized="À propos du Logiciel..."/>
        <entry key="grp_progress" default="Stato Avanzamento Processo" localized="État d'Avancement du Processus"/>
        <entry key="lbl_step" default="Passaggio:" localized="Étape :"/>
        <entry key="lbl_eta" default="Tempo Rimanente:" localized="Temps Restant :"/>
        <entry key="status_idle" default="Pronto. Inserisci un URL di YouTube per iniziare." localized="Prêt. Collez une URL YouTube pour commencer."/>
        <entry key="status_idle_summary" default="Nessun video analizzato. Inserisci un link e premi &quot;Incolla e Analizza Link&quot;." localized="Aucune vidéo analysée. Collez un lien et cliquez sur &quot;Coller et Analyser le Lien&quot;."/>
        <entry key="status_analyzing" default="Analisi video in corso..." localized="Analyse vidéo en cours..."/>
        <entry key="status_ready" default="Analisi completata. Scegli le opzioni e avvia il download." localized="Analyse terminée. Choisissez les options et démarrez le téléchargement."/>
        <entry key="status_downloading" default="Download e lavorazione in corso..." localized="Téléchargement et traitement en cours..."/>
        <entry key="status_completed" default="Operazione completata con successo!" localized="Opération terminée avec succès !"/>
        <entry key="status_file_selected" default="File selezionato nella cartella." localized="Fichier sélectionné dans le dossier."/>
        <entry key="status_folder_opened" default="Cartella aperta con successo." localized="Dossier ouvert avec succès."/>
        <entry key="status_cancelled" default="Processo annullato dall'utente." localized="Processus annulé par l'utilisateur."/>
        <entry key="status_indeterminate" default="Indeterminato" localized="Indéterminé"/>
        <entry key="status_error" default="Errore:" localized="Erreur :"/>
