        <entry key="btn_sys_integration_on" default="Nel Menu Sistema" localized="Dans le Menu Système"/>
        <entry key="btn_sys_integration_off" default="Integra nel Sistema" localized="Intégrer au Système"/>
        <entry key="tip_sys_integration_on" default="L'application est visible dans les menus et la recherche système. Cliquez pour supprimer." localized="L'application est visible dans les menus et la recherche système. Cliquez pour supprimer."/>
        <entry key="tip_sys_integration_off" default="Rend l'application visible dans le menu des applications et la recherche du système." localized="Rend l'application visible dans le menu des applications et la recherche du système."/>
        <entry key="status_sys_integrated" default="Application intégrée au menu système avec succès !" localized="Application intégrée au menu système avec succès !"/>
        <entry key="status_sys_unintegrated" default="Application retirée du menu système." localized="Application retirée du menu système."/>
