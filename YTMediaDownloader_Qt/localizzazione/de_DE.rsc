<?xml version="1.0" encoding="UTF-8"?>
<localization lang="de_DE">
    <window name="MainWindow">
        <entry key="window_title" default="YT Media Downloader Pro" localized="YT Media Downloader Pro"/>
        <entry key="grp_url" default="Link Video YouTube" localized="YouTube-Videolink"/>
        <entry key="lbl_url" default="Link Video YouTube:" localized="YouTube-Videolink:"/>
        <entry key="txt_url_placeholder" default="Incolla qui il link di YouTube (es. https://www.youtube.com/watch?v=...)" localized="YouTube-Link hier einfügen (z. B. https://www.youtube.com/watch?v=...)"/>
        <entry key="btn_paste_analyze" default="Incolla e Analizza Link" localized="Einfügen &amp; Analysieren"/>
        <entry key="btn_cancel_process" default="Blocca Processo" localized="Vorgang Abbrechen"/>
        <entry key="grp_summary" default="Opzioni Selezionate" localized="Ausgewählte Optionen"/>
        <entry key="btn_edit_options" default="Modifica Opzioni..." localized="Optionen Bearbeiten..."/>
        <entry key="lbl_save_path" default="Cartella di Salvataggio:" localized="Speicherordner:"/>
        <entry key="btn_browse" default="Sfoglia..." localized="Durchsuchen..."/>
        <entry key="btn_language" default="Lingua" localized="Sprache"/>
        <entry key="tip_language" default="Seleziona la lingua dell'interfaccia" localized="Wählen Sie die Sprache der Benutzeroberfläche"/>
        <entry key="btn_settings" default="Impostazioni" localized="Einstellungen"/>
        <entry key="btn_help" default="Guida Utente" localized="Benutzerhandbuch"/>
        <entry key="btn_download" default="Avvia Download" localized="Download Starten"/>
        <entry key="btn_stop_download" default="Blocca Download" localized="Download Stoppen"/>
        <entry key="btn_open_file" default="Apri File Scaricato" localized="Heruntergeladene Datei Öffnen"/>
        <entry key="btn_open_folder" default="Mostra nella Cartella" localized="Im Ordner Anzeigen"/>
        <entry key="lbl_language" default="Lingua:" localized="Sprache:"/>
        <entry key="btn_sys_integration_on" default="Nel Menu Sistema" localized="Im Systemmenü"/>
        <entry key="btn_sys_integration_off" default="Integra nel Sistema" localized="Im System Integrieren"/>
        <entry key="tip_sys_integration_on" default="L'applicazione è visibile nei menu e nella ricerca del sistema operativo. Clicca per disabilitarla." localized="Die Anwendung ist in den Desktop-Menüs und der Suche integriert. Klicken zum Entfernen."/>
        <entry key="tip_sys_integration_off" default="Rende l'applicazione visibile nel menu applicazioni e nella ricerca di sistema del computer." localized="Macht die Anwendung im Anwendungsmenü und in der Systemsuchfunktion sichtbar."/>
        <entry key="status_sys_integrated" default="Applicazione integrata nel menu di sistema con successo!" localized="Anwendung erfolgreich im Systemmenü integriert!"/>
        <entry key="status_sys_unintegrated" default="Applicazione rimossa dal menu di sistema." localized="Anwendung aus dem Systemmenü entfernt."/>
        <entry key="menu_file" default="&amp;File" localized="&amp;Datei"/>
        <entry key="menu_options" default="&amp;Opzioni" localized="&amp;Optionen"/>
        <entry key="menu_language" default="&amp;Lingua" localized="&amp;Sprache"/>
        <entry key="menu_help" default="&amp;Aiuto" localized="&amp;Hilfe"/>
        <entry key="act_paste_analyze" default="Incolla e Analizza Link" localized="Einfügen &amp; Analysieren"/>
