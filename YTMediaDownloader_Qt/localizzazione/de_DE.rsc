        <entry key="grp_subs" default="Sottotitoli da Allegare (Selezione Multipla)" localized="Auszugleichende Untertitel (Mehrfachauswahl)"/>
        <entry key="btn_select_all" default="Seleziona Tutti" localized="Alle Auswählen"/>
        <entry key="btn_deselect_all" default="Deseleziona Tutti" localized="Alle Abwählen"/>
        <entry key="btn_confirm" default="Conferma Selezione" localized="Auswahl Bestätigen"/>
        <entry key="btn_cancel" default="Annulla" localized="Abbrechen"/>
        <entry key="header_audio_orig" default="--- TRACCE AUDIO ORIGINALI ---" localized="--- ORIGINALE AUDIOSPUREN ---"/>
        <entry key="header_audio_app" default="--- TRACCE AUDIO LOCALIZZATE (%1) ---" localized="--- LOKALISIERTE AUDIOSPUREN (%1) ---"/>
        <entry key="header_audio_other" default="--- ALTRE TRACCE AUDIO ---" localized="--- WEITERE AUDIOSPUREN ---"/>
        <entry key="header_subs_orig" default="--- SOTTOTITOLI ORIGINALI ---" localized="--- ORIGINALE UNTERTITEL ---"/>
        <entry key="header_subs_app" default="--- SOTTOTITOLI LOCALIZZATI (%1) ---" localized="--- LOKALISIERTE UNTERTITEL (%1) ---"/>
        <entry key="header_subs_other" default="--- ALTRI SOTTOTITOLI ---" localized="--- WEITERE UNTERTITEL ---"/>
    </window>
    <window name="SettingsDialog">
        <entry key="window_title" default="Preferenze Applicazione" localized="Programmeinstellungen"/>
        <entry key="grp_general" default="Impostazioni Generali" localized="Allgemeine Einstellungen"/>
        <entry key="lbl_default_path" default="Percorso di Salvataggio Predefinito:" localized="Standard-Speicherpfad:"/>
        <entry key="lbl_default_lang" default="Lingua Predefinita:" localized="Standardsprache:"/>
        <entry key="btn_save" default="Salva Preferenze" localized="Einstellungen Speichern"/>
        <entry key="btn_cancel" default="Annulla" localized="Abbrechen"/>
    </window>
    <window name="HelpDialog">
        <entry key="window_title" default="Guida Utente - YTMediaDownloader" localized="Benutzerhandbuch - YTMediaDownloader"/>
        <entry key="lbl_guide_lang" default="Lingua Guida:" localized="Handbuchsprache:"/>
        <entry key="btn_open_browser" default="Apri nel Browser" localized="Im Browser Öffnen"/>
        <entry key="btn_close" default="Chiudi" localized="Schließen"/>
    </window>
    <window name="AboutDialog">
        <entry key="window_title" default="Informazioni su YT Media Downloader Pro" localized="Über YT Media Downloader Pro"/>
        <entry key="app_name" default="YT Media Downloader Pro" localized="YT Media Downloader Pro"/>
        <entry key="idea_credit" default="Software realizzato con IA su un'idea di PsyTech6." localized="Software realizzato con IA su un'idea di PsyTech6."/>
        <entry key="app_description" default="Strumento avanzato e ad alte prestazioni per l'analisi, il download, l'estrazione e il muxing di flussi multimediali da YouTube. Supporta risoluzioni video fino a 4K/8K, download multitraccia con canali audio localizzati e integrazione dei sottotitoli conformi agli standard ISO 639." localized="Fortschrittliches Hochleistungswerkzeug zum Analysieren, Herunterladen und Multiplexen von YouTube-Medienströmen. Unterstützt Videoauflösungen bis 4K/8K, Mehrspur-Audio und ISO 639-konforme Untertitel."/>
        <entry key="tech_info" default="Tecnologie integrate: Qt 5 (C++17), FFmpeg / ffprobe multithread, yt-dlp con protocollo anti-rate limit. Rilasciato come pacchetto portabile standalone universale." localized="Integrierte Technologien: Qt 5 (C++17), Multithreaded FFmpeg / ffprobe, yt-dlp mit Anti-Rate-Limiting. Veröffentlicht als universelles eigenständiges AppImage-Paket."/>
        <entry key="btn_close" default="Chiudi" localized="Schließen"/>
    </window>
</localization>
