        <entry key="act_cancel_process" default="Blocca Processo" localized="Vorgang Abbrechen"/>
        <entry key="act_open_file" default="Apri File Scaricato" localized="Heruntergeladene Datei Öffnen"/>
        <entry key="act_open_folder" default="Mostra nella Cartella" localized="Im Ordner Anzeigen"/>
        <entry key="act_exit" default="Esci" localized="Beenden"/>
        <entry key="act_edit_options" default="Modifica Opzioni Video/Audio..." localized="Video-/Audio-Optionen Bearbeiten..."/>
        <entry key="act_toggle_integration" default="Visibilità nei Menu di Sistema" localized="Systemmenü-Integration"/>
        <entry key="act_settings" default="Impostazioni..." localized="Einstellungen..."/>
        <entry key="act_help" default="Guida Utente" localized="Benutzerhandbuch"/>
        <entry key="act_about" default="Informazioni sul Software..." localized="Über die Software..."/>
        <entry key="grp_progress" default="Stato Avanzamento Processo" localized="Fortschrittsstatus"/>
        <entry key="lbl_step" default="Passaggio:" localized="Schritt:"/>
        <entry key="lbl_eta" default="Tempo Rimanente:" localized="Verbleibende Zeit:"/>
        <entry key="status_idle" default="Pronto. Inserisci un URL di YouTube per iniziare." localized="Bereit. Fügen Sie eine YouTube-URL ein, um zu beginnen."/>
        <entry key="status_idle_summary" default="Nessun video analizzato. Inserisci un link e premi &quot;Incolla e Analizza Link&quot;." localized="Kein Video analysiert. Fügen Sie einen Link ein und klicken Sie auf &quot;Einfügen &amp; Analysieren&quot;."/>
        <entry key="status_analyzing" default="Analisi video in corso..." localized="Videoanalyse läuft..."/>
        <entry key="status_ready" default="Analisi completata. Scegli le opzioni e avvia il download." localized="Analyse abgeschlossen. Wählen Sie Optionen und starten Sie den Download."/>
        <entry key="status_downloading" default="Download e lavorazione in corso..." localized="Download und Verarbeitung laufen..."/>
        <entry key="status_completed" default="Operazione completata con successo!" localized="Vorgang erfolgreich abgeschlossen!"/>
        <entry key="status_file_selected" default="File selezionato nella cartella." localized="Datei im Ordner ausgewählt."/>
        <entry key="status_folder_opened" default="Cartella aperta con successo." localized="Ordner erfolgreich geöffnet."/>
        <entry key="status_cancelled" default="Processo annullato dall'utente." localized="Vorgang durch Benutzer abgebrochen."/>
        <entry key="status_indeterminate" default="Indeterminato" localized="Unbestimmt"/>
        <entry key="status_error" default="Errore:" localized="Fehler:"/>
        <entry key="summary_title" default="Titolo Video" localized="Videotitel"/>
        <entry key="summary_resolution" default="Risoluzione Selezionata" localized="Ausgewählte Auflösung"/>
        <entry key="summary_container" default="Contenitore" localized="Container"/>
        <entry key="summary_audio_tracks" default="Tracce Audio Selezionate" localized="Ausgewählte Audiospuren"/>
        <entry key="summary_subtitles" default="Sottotitoli Selezionati" localized="Ausgewählte Untertitel"/>
        <entry key="summary_default_audio" default="Audio Predefinito" localized="Standard-Audio"/>
        <entry key="summary_no_subtitles" default="Nessun sottotitolo" localized="Keine Untertitel"/>
        <entry key="already_running_title" default="Applicazione già attiva" localized="Anwendung bereits aktiv"/>
        <entry key="already_running_msg" default="Un'altra istanza di YTMediaDownloader è già in esecuzione nel sistema. Non è consentito eseguire più istanze contemporaneamente." localized="Eine andere Instanz von YTMediaDownloader wird bereits ausgeführt. Mehrere gleichzeitige Instanzen sind nicht zulässig."/>
    </window>
    <window name="MediaAnalyzerDialog">
        <entry key="window_title" default="Analisi e Selezione Tracce Media" localized="Medienspuren-Analyse und Auswahl"/>
        <entry key="grp_video" default="Formato e Risoluzione Video" localized="Videoformat &amp; Auflösung"/>
        <entry key="lbl_resolution" default="Risoluzione Video:" localized="Videoauflösung:"/>
        <entry key="lbl_container" default="Contenitore Output:" localized="Ausgabe-Container:"/>
