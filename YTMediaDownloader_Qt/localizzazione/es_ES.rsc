        <entry key="lbl_language" default="Lingua:" localized="Idioma:"/>
        <entry key="btn_sys_integration_on" default="Nel Menu Sistema" localized="En Menú del Sistema"/>
        <entry key="btn_sys_integration_off" default="Integra nel Sistema" localized="Integrar en el Sistema"/>
        <entry key="tip_sys_integration_on" default="L'applicazione è visibile nei menu e nella ricerca del sistema operativo. Clicca per disabilitarla." localized="La aplicación está integrada en los menús y la búsqueda del sistema. Haz clic para eliminarla."/>
        <entry key="tip_sys_integration_off" default="Rende l'applicazione visibile nel menu applicazioni e nella ricerca di sistema del computer." localized="Hace visible la aplicación en el menú de aplicaciones y en la búsqueda del sistema."/>
        <entry key="status_sys_integrated" default="Applicazione integrata nel menu di sistema con successo!" localized="¡Aplicación integrada con éxito en el menú del sistema!"/>
        <entry key="status_sys_unintegrated" default="Applicazione rimossa dal menu di sistema." localized="Aplicación eliminada del menú del sistema."/>
        <entry key="menu_file" default="&amp;File" localized="&amp;Archivo"/>
        <entry key="menu_options" default="&amp;Opzioni" localized="&amp;Opciones"/>
        <entry key="menu_language" default="&amp;Lingua" localized="&amp;Idioma"/>
