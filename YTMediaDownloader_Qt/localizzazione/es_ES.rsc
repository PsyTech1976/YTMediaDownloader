        <entry key="txt_url_placeholder" default="Incolla qui il link di YouTube (es. https://www.youtube.com/watch?v=...)" localized="Pega aquí el enlace de YouTube (ej. https://www.youtube.com/watch?v=...)"/>
        <entry key="btn_paste_analyze" default="Incolla e Analizza Link" localized="Pegar y Analizar Enlace"/>
