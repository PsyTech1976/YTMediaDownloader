        <entry key="btn_download" default="Avvia Download" localized="Iniciar Descarga"/>
        <entry key="btn_stop_download" default="Blocca Download" localized="Detener Descarga"/>
        <entry key="btn_open_file" default="Apri File Scaricato" localized="Abrir Archivo Descargado"/>
