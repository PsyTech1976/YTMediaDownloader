        <entry key="grp_subs" default="Sottotitoli da Allegare (Selezione Multipla)" localized="Subtítulos para Adjuntar (Selección Múltiple)"/>
        <entry key="btn_select_all" default="Seleziona Tutti" localized="Seleccionar Todo"/>
        <entry key="btn_deselect_all" default="Deseleziona Tutti" localized="Deseleccionar Todo"/>
        <entry key="btn_confirm" default="Conferma Selezione" localized="Confirmar Selección"/>
        <entry key="btn_cancel" default="Annulla" localized="Cancelar"/>
        <entry key="header_audio_orig" default="--- TRACCE AUDIO ORIGINALI ---" localized="--- PISTAS DE AUDIO ORIGINALES ---"/>
        <entry key="header_audio_app" default="--- TRACCE AUDIO LOCALIZZATE (%1) ---" localized="--- PISTAS DE AUDIO LOCALIZADAS (%1) ---"/>
        <entry key="header_audio_other" default="--- ALTRE TRACCE AUDIO ---" localized="--- OTRAS PISTAS DE AUDIO ---"/>
        <entry key="header_subs_orig" default="--- SOTTOTITOLI ORIGINALI ---" localized="--- SUBTÍTULOS ORIGINALES ---"/>
        <entry key="header_subs_app" default="--- SOTTOTITOLI LOCALIZZATI (%1) ---" localized="--- SUBTÍTULOS LOCALIZADOS (%1) ---"/>
        <entry key="header_subs_other" default="--- ALTRI SOTTOTITOLI ---" localized="--- OTROS SUBTÍTULOS ---"/>
    </window>
    <window name="SettingsDialog">
        <entry key="window_title" default="Preferenze Applicazione" localized="Preferencias de la Aplicación"/>
        <entry key="grp_general" default="Impostazioni Generali" localized="Ajustes Generales"/>
        <entry key="lbl_default_path" default="Percorso di Salvataggio Predefinito:" localized="Carpeta de Guardado Predeterminada:"/>
        <entry key="lbl_default_lang" default="Lingua Predefinita:" localized="Idioma Predeterminado:"/>
        <entry key="btn_save" default="Salva Preferenze" localized="Guardar Preferencias"/>
        <entry key="btn_cancel" default="Annulla" localized="Cancelar"/>
    </window>
    <window name="HelpDialog">
        <entry key="window_title" default="Guida Utente - YTMediaDownloader" localized="Guía de Usuario - YTMediaDownloader"/>
        <entry key="lbl_guide_lang" default="Lingua Guida:" localized="Idioma de la Guía:"/>
        <entry key="btn_open_browser" default="Apri nel Browser" localized="Abrir en el Navegador"/>
        <entry key="btn_close" default="Chiudi" localized="Cerrar"/>
    </window>
    <window name="AboutDialog">
        <entry key="window_title" default="Informazioni su YT Media Downloader Pro" localized="Acerca de YT Media Downloader Pro"/>
        <entry key="app_name" default="YT Media Downloader Pro" localized="YT Media Downloader Pro"/>
        <entry key="idea_credit" default="Software realizzato con IA su un'idea di PsyTech6." localized="Software realizzato con IA su un'idea di PsyTech6."/>
        <entry key="app_description" default="Strumento avanzato e ad alte prestazioni per l'analisi, il download, l'estrazione e il muxing di flussi multimediali da YouTube. Supporta risoluzioni video fino a 4K/8K, download multitraccia con canali audio localizzati e integrazione dei sottotitoli conformi agli standard ISO 639." localized="Herramienta avanzada de alto rendimiento para el análisis, descarga y multiplexación de transmisiones multimedia de YouTube. Admite resoluciones de video de hasta 4K/8K, descargas multipista con audio localizado y subtítulos conformes a la norma ISO 639."/>
        <entry key="tech_info" default="Tecnologie integrate: Qt 5 (C++17), FFmpeg / ffprobe multithread, yt-dlp con protocollo anti-rate limit. Rilasciato come pacchetto portabile standalone universale." localized="Tecnologías integradas: Qt 5 (C++17), FFmpeg / ffprobe multihilo, yt-dlp con protocolo anti-límite. Distribuido como paquete portátil autónomo universal."/>
        <entry key="btn_close" default="Chiudi" localized="Cerrar"/>
    </window>
</localization>
