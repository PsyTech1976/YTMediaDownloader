        <entry key="act_toggle_integration" default="Visibilità nei Menu di Sistema" localized="Visibilidad en Menús del Sistema"/>
        <entry key="act_settings" default="Impostazioni..." localized="Ajustes..."/>
        <entry key="act_help" default="Guida Utente" localized="Guía de Usuario"/>
        <entry key="act_about" default="Informazioni sul Software..." localized="Acerca del Software..."/>
        <entry key="grp_progress" default="Stato Avanzamento Processo" localized="Estado de Progreso"/>
        <entry key="lbl_step" default="Passaggio:" localized="Paso:"/>
        <entry key="lbl_eta" default="Tempo Rimanente:" localized="Tiempo Restante:"/>
        <entry key="status_idle" default="Pronto. Inserisci un URL di YouTube per iniziare." localized="Listo. Pega una URL de YouTube para comenzar."/>
        <entry key="status_idle_summary" default="Nessun video analizzato. Inserisci un link e premi &quot;Incolla e Analizza Link&quot;." localized="Ningún video analizado. Pega un enlace y presiona &quot;Pegar y Analizar Enlace&quot;."/>
        <entry key="status_analyzing" default="Analisi video in corso..." localized="Analizando video..."/>
        <entry key="status_ready" default="Analisi completata. Scegli le opzioni e avvia il download." localized="Análisis completado. Elige las opciones e inicia la descarga."/>
        <entry key="status_downloading" default="Download e lavorazione in corso..." localized="Descarga y procesamiento en curso..."/>
        <entry key="status_completed" default="Operazione completata con successo!" localized="¡Operación completada con éxito!"/>
        <entry key="status_file_selected" default="File selezionato nella cartella." localized="Archivo seleccionado en la carpeta."/>
        <entry key="status_folder_opened" default="Cartella aperta con successo." localized="Carpeta abierta con éxito."/>
        <entry key="status_cancelled" default="Processo annullato dall'utente." localized="Proceso cancelado por el usuario."/>
        <entry key="status_indeterminate" default="Indeterminato" localized="Indeterminado"/>
        <entry key="status_error" default="Errore:" localized="Error:"/>
        <entry key="summary_title" default="Titolo Video" localized="Título del Video"/>
        <entry key="summary_resolution" default="Risoluzione Selezionata" localized="Resolución Seleccionada"/>
        <entry key="summary_container" default="Contenitore" localized="Contenedor"/>
        <entry key="summary_audio_tracks" default="Tracce Audio Selezionate" localized="Pistas de Audio Seleccionadas"/>
        <entry key="summary_subtitles" default="Sottotitoli Selezionati" localized="Subtítulos Seleccionados"/>
        <entry key="summary_default_audio" default="Audio Predefinito" localized="Audio Predeterminado"/>
        <entry key="summary_no_subtitles" default="Nessun sottotitolo" localized="Sin subtítulos"/>
        <entry key="already_running_title" default="Applicazione già attiva" localized="Aplicación ya activa"/>
        <entry key="already_running_msg" default="Un'altra istanza di YTMediaDownloader è già in esecuzione nel sistema. Non è consentito eseguire più istanze contemporaneamente." localized="Ya se está ejecutando otra instancia de YTMediaDownloader. No se permiten varias instancias simultáneas."/>
    </window>
    <window name="MediaAnalyzerDialog">
        <entry key="window_title" default="Analisi e Selezione Tracce Media" localized="Análisis y Selección de Pistas de Medios"/>
        <entry key="grp_video" default="Formato e Risoluzione Video" localized="Formato y Resolución de Video"/>
        <entry key="lbl_resolution" default="Risoluzione Video:" localized="Resolución de Video:"/>
        <entry key="lbl_container" default="Contenitore Output:" localized="Contenedor de Salida:"/>
