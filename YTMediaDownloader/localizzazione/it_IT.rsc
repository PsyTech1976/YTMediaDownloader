    <window name="AboutDialog">
        <entry key="window_title" default="Informazioni su YT Media Downloader Pro" localized="Informazioni su YT Media Downloader Pro"/>
        <entry key="app_name" default="YT Media Downloader Pro" localized="YT Media Downloader Pro"/>
        <entry key="idea_credit" default="Software realizzato con IA su un'idea di PsyTech6." localized="Software realizzato con IA su un'idea di PsyTech6."/>
        <entry key="app_description" default="Strumento avanzato e ad alte prestazioni per l'analisi, il download, l'estrazione e il muxing di flussi multimediali da YouTube. Supporta risoluzioni video fino a 4K/8K, download multitraccia con canali audio localizzati e integrazione dei sottotitoli conformi agli standard ISO 639." localized="Strumento avanzato e ad alte prestazioni per l'analisi, il download, l'estrazione e il muxing di flussi multimediali da YouTube. Supporta risoluzioni video fino a 4K/8K, download multitraccia con canali audio localizzati e integrazione dei sottotitoli conformi agli standard ISO 639."/>
        <entry key="tech_info" default="Tecnologie integrate: Qt 5 (C++17), FFmpeg / ffprobe multithread, yt-dlp con protocollo anti-rate limit. Rilasciato come pacchetto portabile standalone universale." localized="Tecnologie integrate: Qt 5 (C++17), FFmpeg / ffprobe multithread, yt-dlp con protocollo anti-rate limit. Rilasciato come pacchetto portabile standalone universale."/>
        <entry key="btn_close" default="Chiudi" localized="Chiudi"/>
    </window>
</localization>
