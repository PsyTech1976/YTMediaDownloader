        <entry key="act_download" default="Avvia Download" localized="Start Download"/>
        <entry key="act_cancel_process" default="Blocca Processo" localized="Cancel Process"/>
        <entry key="act_open_file" default="Apri File Scaricato" localized="Open Downloaded File"/>
        <entry key="act_open_folder" default="Mostra nella Cartella" localized="Show in Folder"/>
        <entry key="act_exit" default="Esci" localized="Exit"/>
        <entry key="act_edit_options" default="Modifica Opzioni Video/Audio..." localized="Edit Video/Audio Options..."/>
        <entry key="act_toggle_integration" default="Visibilità nei Menu di Sistema" localized="System Menu Integration"/>
        <entry key="act_settings" default="Impostazioni..." localized="Settings..."/>
        <entry key="act_help" default="Guida Utente" localized="User Guide"/>
        <entry key="act_about" default="Informazioni sul Software..." localized="About YT Media Downloader..."/>
        <entry key="grp_progress" default="Stato Avanzamento Processo" localized="Process Progress Status"/>
        <entry key="lbl_step" default="Passaggio:" localized="Step:"/>
        <entry key="lbl_eta" default="Tempo Rimanente:" localized="Remaining Time:"/>
        <entry key="status_idle" default="Pronto. Inserisci un URL di YouTube per iniziare." localized="Ready. Paste a YouTube URL to get started."/>
        <entry key="status_idle_summary" default="Nessun video analizzato. Inserisci un link e premi &quot;Incolla e Analizza Link&quot;." localized="No video analyzed yet. Paste a link and click &quot;Paste &amp; Analyze Link&quot;."/>
        <entry key="status_analyzing" default="Analisi video in corso..." localized="Analyzing video stream..."/>
        <entry key="status_ready" default="Analisi completata. Scegli le opzioni e avvia il download." localized="Analysis complete. Choose options and start download."/>
        <entry key="status_downloading" default="Download e lavorazione in corso..." localized="Downloading and processing in progress..."/>
        <entry key="status_completed" default="Operazione completata con successo!" localized="Operation completed successfully!"/>
        <entry key="status_cancelled" default="Processo annullato dall'utente." localized="Process cancelled by user."/>
        <entry key="status_indeterminate" default="Indeterminato" localized="Indeterminate"/>
        <entry key="status_error" default="Errore:" localized="Error:"/>
