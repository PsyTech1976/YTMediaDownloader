        <entry key="summary_resolution" default="Risoluzione Selezionata" localized="Selected Resolution"/>
        <entry key="summary_container" default="Contenitore" localized="Container"/>
        <entry key="summary_audio_tracks" default="Tracce Audio Selezionate" localized="Selected Audio Tracks"/>
        <entry key="summary_subtitles" default="Sottotitoli Selezionati" localized="Selected Subtitles"/>
        <entry key="summary_default_audio" default="Audio Predefinito" localized="Default Audio"/>
        <entry key="summary_no_subtitles" default="Nessun sottotitolo" localized="No Subtitles"/>
        <entry key="already_running_title" default="Applicazione già attiva" localized="Application Already Running"/>
        <entry key="already_running_msg" default="Un'altra istanza di YTMediaDownloader è già in esecuzione nel sistema. Non è consentito eseguire più istanze contemporaneamente." localized="Another instance of YTMediaDownloader is already running. Multiple concurrent instances are not permitted."/>
