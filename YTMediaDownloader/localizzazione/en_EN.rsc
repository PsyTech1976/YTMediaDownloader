    <window name="MediaAnalyzerDialog">
        <entry key="window_title" default="Analisi e Selezione Tracce Media" localized="Media Tracks Analysis &amp; Selection"/>
        <entry key="grp_video" default="Formato e Risoluzione Video" localized="Video Format &amp; Resolution"/>
        <entry key="lbl_resolution" default="Risoluzione Video:" localized="Video Resolution:"/>
        <entry key="lbl_container" default="Contenitore Output:" localized="Output Container:"/>
        <entry key="grp_audio" default="Tracce Audio da Allegare (Selezione Multipla)" localized="Audio Tracks to Attach (Multi-Selection)"/>
        <entry key="grp_subs" default="Sottotitoli da Allegare (Selezione Multipla)" localized="Subtitles to Attach (Multi-Selection)"/>
        <entry key="btn_select_all" default="Seleziona Tutti" localized="Select All"/>
        <entry key="btn_deselect_all" default="Deseleziona Tutti" localized="Deselect All"/>
        <entry key="btn_confirm" default="Conferma Selezione" localized="Confirm Selection"/>
        <entry key="btn_cancel" default="Annulla" localized="Cancel"/>
        <entry key="header_audio_orig" default="--- TRACCE AUDIO ORIGINALI ---" localized="--- ORIGINAL AUDIO TRACKS ---"/>
        <entry key="header_audio_app" default="--- TRACCE AUDIO LOCALIZZATE (%1) ---" localized="--- LOCALIZED AUDIO TRACKS (%1) ---"/>
        <entry key="header_audio_other" default="--- ALTRE TRACCE AUDIO ---" localized="--- OTHER AUDIO TRACKS ---"/>
        <entry key="header_subs_orig" default="--- SOTTOTITOLI ORIGINALI ---" localized="--- ORIGINAL SUBTITLES ---"/>
        <entry key="header_subs_app" default="--- SOTTOTITOLI LOCALIZZATI (%1) ---" localized="--- LOCALIZED SUBTITLES (%1) ---"/>
        <entry key="header_subs_other" default="--- ALTRI SOTTOTITOLI ---" localized="--- OTHER SUBTITLES ---"/>
    </window>
    <window name="SettingsDialog">
        <entry key="window_title" default="Preferenze Applicazione" localized="Application Preferences"/>
        <entry key="grp_general" default="Impostazioni Generali" localized="General Settings"/>
        <entry key="lbl_default_path" default="Percorso di Salvataggio Predefinito:" localized="Default Save Directory:"/>
        <entry key="lbl_default_lang" default="Lingua Predefinita:" localized="Default Language:"/>
        <entry key="btn_save" default="Salva Preferenze" localized="Save Preferences"/>
        <entry key="btn_cancel" default="Annulla" localized="Cancel"/>
    </window>
    <window name="HelpDialog">
        <entry key="window_title" default="Guida Utente - YTMediaDownloader" localized="User Guide - YTMediaDownloader"/>
        <entry key="lbl_guide_lang" default="Lingua Guida:" localized="Guide Language:"/>
        <entry key="btn_open_browser" default="Apri nel Browser" localized="Open in Browser"/>
        <entry key="btn_close" default="Chiudi" localized="Close"/>
    </window>
    <window name="AboutDialog">
        <entry key="window_title" default="Informazioni su YT Media Downloader Pro" localized="About YT Media Downloader Pro"/>
        <entry key="app_name" default="YT Media Downloader Pro" localized="YT Media Downloader Pro"/>
        <entry key="idea_credit" default="Software realizzato con IA su un'idea di PsyTech6." localized="Software realizzato con IA su un'idea di PsyTech6."/>
        <entry key="app_description" default="Strumento avanzato e ad alte prestazioni per l'analisi, il download, l'estrazione e il muxing di flussi multimediali da YouTube. Supporta risoluzioni video fino a 4K/8K, download multitraccia con canali audio localizzati e integrazione dei sottotitoli conformi agli standard ISO 639." localized="Advanced high-performance tool for analyzing, downloading, extracting, and multiplexing YouTube media streams. Supports video resolutions up to 4K/8K, multitrack downloads with localized audio, and ISO 639 compliant subtitle embedding."/>
        <entry key="tech_info" default="Tecnologie integrate: Qt 5 (C++17), FFmpeg / ffprobe multithread, yt-dlp con protocollo anti-rate limit. Rilasciato come pacchetto portabile standalone universale." localized="Integrated technologies: Qt 5 (C++17), multithreaded FFmpeg / ffprobe, yt-dlp with anti-rate limiting protocol. Released as universal standalone portable package."/>
        <entry key="btn_close" default="Chiudi" localized="Close"/>
    </window>
</localization>
