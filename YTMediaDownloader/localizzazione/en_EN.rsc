        <entry key="txt_url_placeholder" default="Incolla qui il link di YouTube (es. https://www.youtube.com/watch?v=...)" localized="Paste YouTube link here (e.g. https://www.youtube.com/watch?v=...)"/>
        <entry key="btn_paste_analyze" default="Incolla e Analizza Link" localized="Paste &amp; Analyze Link"/>
        <entry key="btn_cancel_process" default="Blocca Processo" localized="Cancel Process"/>
