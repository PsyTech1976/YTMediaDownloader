        <entry key="btn_open_folder" default="Mostra nella Cartella" localized="Show in Folder"/>
        <entry key="lbl_language" default="Lingua:" localized="Language:"/>
        <entry key="btn_sys_integration_on" default="Nel Menu Sistema" localized="In System Menu"/>
        <entry key="btn_sys_integration_off" default="Integra nel Sistema" localized="Integrate with System"/>
        <entry key="tip_sys_integration_on" default="L'applicazione è visibile nei menu e nella ricerca del sistema operativo. Clicca per disabilitarla." localized="Application is integrated in OS app menus and search. Click to remove."/>
        <entry key="tip_sys_integration_off" default="Rende l'applicazione visibile nel menu applicazioni e nella ricerca di sistema del computer." localized="Makes application visible in desktop app menus and system search."/>
        <entry key="status_sys_integrated" default="Applicazione integrata nel menu di sistema con successo!" localized="Application successfully integrated into system menu!"/>
        <entry key="status_sys_unintegrated" default="Applicazione rimossa dal menu di sistema." localized="Application removed from system menu."/>
